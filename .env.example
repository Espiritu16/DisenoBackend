# Copia este archivo como .env y completa los valores locales.
# No subas .env al repositorio.

# Base de datos MySQL
DB_URL=jdbc:mysql://localhost:3306/aquacomunidad_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Lima
DB_USERNAME=root
DB_PASSWORD=

# CORS
CORS_ALLOWED_ORIGIN_PATTERNS=https://diseno-frontend.vercel.app,https://diseno-frontend-7n1672j2y-espiritu16s-projects.vercel.app,https://*.vercel.app,https://proyectoutp.com,http://proyectoutp.com,http://localhost:*,https://localhost:*,http://127.0.0.1:*,https://127.0.0.1:*

# JWT
APP_JWT_SECRETO=CAMBIAR_ESTE_SECRETO_POR_UNO_MUY_SEGURO_DE_64_CARACTERES_MINIMO
APP_JWT_EXPIRACION_SEGUNDOS=7200
APP_JWT_REFRESH_EXPIRACION_SEGUNDOS=2592000

# OpenAI chatbot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Gmail SMTP para recuperacion de contrasena
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# Uploads
# VPS/Docker Compose: usa local con volumen montado a /app/uploads.
# Render: usa sftp para guardar en el VPS.
UPLOAD_STORAGE=local
UPLOAD_DIR=/app/uploads
UPLOAD_PUBLIC_BASE_URL=/uploads
WEBP_COMMAND=cwebp
WEBP_QUALITY=86
UPLOAD_CACHE_MAX_AGE_SECONDS=2592000

# Uploads SFTP para Render. Deja comentado si UPLOAD_STORAGE=local.
# UPLOAD_SFTP_HOST=85.239.248.109
# UPLOAD_SFTP_PORT=22
# UPLOAD_SFTP_USER=aquaupload
# UPLOAD_SFTP_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\nPEGA_AQUI_LA_LLAVE_PRIVADA_COMPLETA\n-----END OPENSSH PRIVATE KEY-----
# UPLOAD_REMOTE_BASE_DIR=/opt/proyectos/aquacomunidad/uploads
# UPLOAD_PUBLIC_BASE_URL=https://upload-aquacomunidad.proyectoutp.com/uploads
# UPLOAD_SFTP_STRICT_HOST_KEY_CHECKING=no
